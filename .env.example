# Template only; nothing loads this file automatically. JWT_SECRET must be exported in the
# shell environment used to start Auth and BFF (e.g. `export JWT_SECRET=...` or
# `$env:JWT_SECRET="..."` in PowerShell). Never commit real values.
# Generate a secret, e.g.: openssl rand -base64 64
# This secret is used for JWT signing and verification in Auth and BFF services.
JWT_SECRET=change-me-to-a-long-random-secret
